{
  "name": "casal-jogos-backend",
  "version": "1.0.0",
  "description": "Servidor de tempo real (Socket.IO) para a plataforma de jogos cooperativos",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
